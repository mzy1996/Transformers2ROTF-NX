# T2ROTF (2026-10-24): Renut's Direct3D-level renderer for the Switch port, and the whole graphics path
# from here on. The engine is Renut (github.com/masterspike52/reNut, "Direct3D only, no PM4, no EDRAM")
# as banjo-nx and then sa2-nx/mgr-nx-deko carry it: imported here from
# repos/mgr-nx-deko/app/src/renut_engine into recomp/src/renut_engine, with the SDK-side bring-up of
# T12/T13 (repos/nfsmw-nx/sdk: no GPU plugin, no Vulkan driver). This file is the app-side wiring,
# modeled on that repository's cmake/mgr_renut_gpu.cmake.
#
# It replaces the emulated Xenos GPU (PM4 ring + EDRAM over NVK, which never presented a frame on the
# console: the guest's ring-space gate polled a word the host never published) with Renut's renderer:
# the guest's Direct3D entry points are hooked and turned into host records, and plume submits them
# through deko3d - Switch-native, no Vulkan driver in the NRO.
#
# An OBJECT library, not a static one: the hooks replace the generated code's weak sub_X definitions,
# and a static archive's members are only pulled in for undefined symbols, so the hooks would silently
# not be linked (the build would succeed and nothing would hook).

# ---------------------------------------------------------------------------
# The shader cache: never generated by this (cross) configure.
# ---------------------------------------------------------------------------
# The cache is built on the PC from the game's dumped Xenos shader containers
# (out/t2-deko-shaders/containers -> out/renut_switch/shader_cache_switch.cpp, a PC build of
# reblue-XenosRecomp). A Switch configure cannot run the translator: it is a host program, and
# gpu.cmake would build it as an ExternalProject with the console's compiler. Defining
# banjo_renut_shader_cache_override before gpu.cmake is included makes it take the prepared file
# instead (and turns off its dump_shaders.py / Python-xxhash check).
# T16: the dump holds every container of the game's six Xenos shader libraries - game/shaders.lsa and
# game/shaders.debug.lsa (347 each), game/effects[.debug].lsa (69), game/debug[.debug].lsa (25) - plus the 141 in
# the TU/base flat. The two libraries of a pair share no container (441 of them differ), and neither the XEX nor its
# patch state which one retail loads, so both are dumped: 987 containers, all of them in the cache.
set(RENUT_SHADER_DUMP_DIR "${CMAKE_SOURCE_DIR}/../out/t2-deko-shaders/containers" CACHE PATH
    "T2ROTF's dumped Xenos shader containers (PC step)")
set(RENUT_ASSETS_DIR "${CMAKE_SOURCE_DIR}/game" CACHE PATH
    "T2ROTF's game assets (default.xex and its bundles)")
set(T2_RENUT_SHADER_CACHE_CPP "${CMAKE_SOURCE_DIR}/../out/renut_switch/shader_cache_switch.cpp"
    CACHE FILEPATH "Renut's shader cache for the Switch build (PC-built from the dumped containers)")
set(T2_RENUT_EMPTY_SHADER_CACHE_CPP "${CMAKE_SOURCE_DIR}/src/renut_engine/generated/t2_shader_cache_empty.cpp")
function(banjo_renut_shader_cache_override TARGET)
  if(EXISTS "${T2_RENUT_SHADER_CACHE_CPP}")
    target_sources(${TARGET} PRIVATE "${T2_RENUT_SHADER_CACHE_CPP}")
    set_source_files_properties("${T2_RENUT_SHADER_CACHE_CPP}" PROPERTIES GENERATED TRUE SKIP_PRECOMPILE_HEADERS ON)
  else()
    # The renderer links, boots and reports every shader as missing (deko3d::MissingGameShaders): no
    # game image until the PC step above has run. Not an error: it keeps the port buildable.
    message(STATUS "t2: no ${T2_RENUT_SHADER_CACHE_CPP}: using the empty shader cache "
                   "(no Xenos shader can be drawn until the PC-built cache is in place)")
    target_sources(${TARGET} PRIVATE "${T2_RENUT_EMPTY_SHADER_CACHE_CPP}")
    set_source_files_properties("${T2_RENUT_EMPTY_SHADER_CACHE_CPP}" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
  endif()
endfunction()

# Renut's SDK exports o1heap as rex::o1heap; this SDK tree names it o1heap.
if(TARGET o1heap AND NOT TARGET rex::o1heap)
  add_library(rex::o1heap ALIAS o1heap)
endif()

# ---------------------------------------------------------------------------
# Switch: plume's deko3d back end and the PC tools its host shaders are built with.
# ---------------------------------------------------------------------------
if(REXGLUE_PLATFORM_SWITCH)
  set(PLUME_PLATFORM_SWITCH ON CACHE BOOL "" FORCE)
  set(PLUME_SWITCH_DEVKITPRO "${DEVKITPRO}" CACHE PATH "" FORCE)
  set(PLUME_SWITCH_NVK_ROOT "${REXGLUE_SWITCH_NVK_SDK}" CACHE PATH "" FORCE)
  set(PLUME_SWITCH_NVK_LIBRARY "${REXGLUE_SWITCH_NVK_SDK}/lib/libvulkan.a" CACHE FILEPATH "" FORCE)
  # T13: this build has no Vulkan driver at all (REXGLUE_SWITCH_NO_NVK), so plume's Vulkan back end is
  # not usable: deko3d is the only path. plume skips its NVK checks with this set.
  set(PLUME_SWITCH_NO_NVK "${REXGLUE_SWITCH_NO_NVK}" CACHE BOOL "" FORCE)
  set(PLUME_SWITCH_UAM_DIR "${CMAKE_SOURCE_DIR}/thirdparty/uam" CACHE PATH "" FORCE)
  set(PLUME_DEKO3D ON CACHE BOOL "deko3d back end (Switch)" FORCE)

  # The host shaders' deko3d blobs (gpu.cmake renut_host_shader -> tools/deko3d_host_shader.py) need
  # DXC (vendored with XenosRecomp), SPIRV-Cross and the PC uam. All three are host programs;
  # tools/deko3d_build_tools.sh builds the latter two into out/deko3d_tools/.
  set(BANJO_DEKO3D_HOST_SHADERS ON)
  set(BANJO_DEKO3D_SPIRV_CROSS "${CMAKE_SOURCE_DIR}/../out/deko3d_tools/spirv-cross-build/spirv-cross.exe"
      CACHE FILEPATH "SPIRV-Cross for the deko3d host shaders (tools/deko3d_build_tools.sh)")
  set(BANJO_DEKO3D_UAM "${CMAKE_SOURCE_DIR}/../out/deko3d_tools/uam-build/uam.exe"
      CACHE FILEPATH "uam (thirdparty/uam built for the PC) for the deko3d host shaders")
  foreach(_t2_tool BANJO_DEKO3D_SPIRV_CROSS BANJO_DEKO3D_UAM)
    if(NOT EXISTS "${${_t2_tool}}")
      message(FATAL_ERROR "No ${${_t2_tool}}: build the host shader tools first (tools/deko3d_build_tools.sh)")
    endif()
  endforeach()

  # The game shaders' GLSL package for deko3d (tools/deko3d_shader_package.py, embedded next to the
  # SPIR-V cache). Also a PC step; banjo_renut_deko3d.cpp declares its symbols weak, so a build without
  # it links and falls back to deko3d_glsl.bin beside the NRO.
  set(BANJO_DEKO3D_GLSL_CPP "${CMAKE_SOURCE_DIR}/../out/renut_switch/deko3d_glsl_switch.cpp"
      CACHE FILEPATH "The deko3d GLSL package's source (tools/deko3d_shader_package.py)" FORCE)
endif()

# The shader steps run Python (the host shaders' deko3d blobs): found here, as the Switch configure has
# no generator target that would find it first.
if(NOT Python3_EXECUTABLE)
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
endif()
if(NOT PYTHON_EXECUTABLE)
  set(PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
endif()

include("${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/gpu.cmake")

# ---------------------------------------------------------------------------
# The renderer itself.
# ---------------------------------------------------------------------------
add_library(t2_renut_gpu OBJECT
    # Renderer selection (gpu/banjo_renut_select.cpp) and its tuning/keys.
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_select.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_tuning.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_checks.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_record.cpp"
    # The display's refresh for the frame limiter (it reads the presents' fences).
    "${CMAKE_SOURCE_DIR}/src/renut_engine/display_sync.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/perf/frame_stats.cpp"
    # The frame latency probe and the pieces banjo-nx's SDK and generated code answered.
    "${CMAKE_SOURCE_DIR}/src/renut_engine/sa2_compat/frame_latency.cpp"
    "${CMAKE_SOURCE_DIR}/src/renut_engine/sa2_compat/sa2_compat.cpp"
    # The game's frames at its presentation interval (the console's vertical blank).
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/sa2_renut_pacing.cpp"
    # What the engine still asks of the SA2 port it came from (see the file).
    "${CMAKE_SOURCE_DIR}/src/t2_src/t2_renut_stubs.cpp")

target_include_directories(t2_renut_gpu PRIVATE
    "${CMAKE_SOURCE_DIR}"
    "${CMAKE_SOURCE_DIR}/src"
    # T16: the PC-built shader cache (out/renut_switch/shader_cache_switch.cpp) includes "shader_cache.h",
    # which lives here (mgr-nx-deko's gpu.cmake adds the same directory).
    "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/shaders"
    # banjo-nx's headers the renderer's tuning includes, answered by this port's (cpu/sa2_enhancements.h, ...).
    "${CMAKE_SOURCE_DIR}/src/renut_engine/sa2_compat"
    "${REXGLUE_ENTRYPOINT_INCLUDE_DIR}"
    # banjo_renut_tuning.cpp: the Switch thread helpers (threading_switch.h, through src/me/me_platform_compat.h).
    "${REXSDK_DIR}/src/core")

if(TARGET rex::runtime)
  target_link_libraries(t2_renut_gpu PRIVATE rex::runtime)
endif()

if(REXGLUE_PLATFORM_SWITCH)
  # deko3d back end: the plume glue and the game shaders' GLSL package.
  target_sources(t2_renut_gpu PRIVATE "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_deko3d.cpp")
  if(EXISTS "${BANJO_DEKO3D_GLSL_CPP}")
    target_sources(t2_renut_gpu PRIVATE "${BANJO_DEKO3D_GLSL_CPP}")
    set_source_files_properties("${BANJO_DEKO3D_GLSL_CPP}" PROPERTIES GENERATED TRUE SKIP_PRECOMPILE_HEADERS ON)
  else()
    message(STATUS "t2: no ${BANJO_DEKO3D_GLSL_CPP}: deko3d_glsl.bin beside the NRO instead")
  endif()
endif()

if(COMMAND rexglue_apply_target_settings)
  rexglue_apply_target_settings(t2_renut_gpu)
endif()

renut_gpu_setup(t2_renut_gpu)

# MGR_RENUT_RENDERER is the name the engine's retargeted code checks for what the two ports have in
# common (guest resource retention, the store-card fallback: sa2_compat.cpp defines
# g_banjo_store_cards under it, and nothing else in this tree does). SA2_RENUT_RENDERER arms the
# renderer's guest-side pieces (sa2_renut_yield.h).
target_compile_definitions(t2_renut_gpu PRIVATE T2ROTF_RENUT_RENDERER=1 MGR_RENUT_RENDERER=1 SA2_RENUT_RENDERER=1)

if(REXGLUE_PLATFORM_SWITCH AND REXGLUE_SWITCH_NO_NVK)
  # No Vulkan driver in this build: Renut on deko3d whatever the cvars say (per source, so nothing
  # else recompiles).
  set_property(SOURCE "${CMAKE_SOURCE_DIR}/src/renut_engine/gpu/banjo_renut_select.cpp"
                      "${RENUT_GPU_DIR}/backend/backend.cpp"
               APPEND PROPERTY COMPILE_DEFINITIONS SA2_SWITCH_NO_NVK=1)
endif()

if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(t2_renut_gpu PRIVATE -ffp-contract=off -fno-strict-aliasing)
endif()

# The app: src/T2ROTF_app.h wires the renderer in (ConfigureRuntime, the overlay drawer, StartRenderer).
target_link_libraries(T2ROTF PRIVATE t2_renut_gpu)